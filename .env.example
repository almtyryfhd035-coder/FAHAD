# .env.example for FAHAD bot
# Copy these variables into your Railway / Render / environment and fill the values where needed.

# Discord
DISCORD_BOT_TOKEN=

# Auto-download settings
# If AUTO_DOWNLOAD=true the bot will try to download MODEL_DOWNLOAD_URL into LLAMA_MODEL_PATH
AUTO_DOWNLOAD=true
# MODEL_DOWNLOAD_URL should be a direct download URL to a ggml/quantized model file (e.g. a gpt4all ggml asset)
# Recommended source (open the releases page and copy the direct asset link):
# https://github.com/nomic-ai/gpt4all/releases
MODEL_DOWNLOAD_URL=https://gpt4all.io/models/

# Where the downloaded model will be saved (do not change unless you know what you're doing)
LLAMA_MODEL_PATH=./models/auto_model.bin
# If you have a compiled llama.cpp binary on the host, set its path here. Leave empty if not available.
LLAMA_CPP_BIN=

# Fallback small model name (used if transformers are installed instead of ggml)
MODEL_NAME=distilgpt2

# Behavior
REPLY_ALL=true
PORT=8080
CREATOR_REPLY=فهد المطيري @w4px

# Notes:
# - MODEL_DOWNLOAD_URL above is not a direct asset link by default. Open the recommended releases page,
#   choose a ggml/quantized model asset (for example a gpt4all .bin), right-click the asset > Copy link address,
#   then paste that direct URL into MODEL_DOWNLOAD_URL. The downloader expects a direct file URL (HTTP 200).
# - Downloading large model files (multiple GB) may fail on free hosting plans (disk, memory, or timeout limits).
#   If download fails on Railway/Render, set AUTO_DOWNLOAD=false so the bot uses the built-in Arabic fallback.
# - For reliable operation with a large model, run the bot locally or on a server with enough disk and RAM.
