# .env.example for FAHAD bot
# Copy these variables into your Railway / Render / environment and fill the values where needed.

# Discord
DISCORD_BOT_TOKEN=

# Choose how to generate replies:
# - Recommended (safer on limited hosts): USE_HF_INFERENCE=true and set HUGGINGFACE_HUB_TOKEN to use Hugging Face Inference API (no large downloads)
# - Or (advanced): AUTO_DOWNLOAD=true with a direct MODEL_DOWNLOAD_URL to a small quantized model (must be <= MAX_DOWNLOAD_MB)

# Use the Hugging Face Inference API (recommended for limited hosting)
USE_HF_INFERENCE=true
HUGGINGFACE_HUB_TOKEN=

# Auto-download settings (only used if AUTO_DOWNLOAD=true)
# The bot will perform a preflight HEAD check and will NOT download files larger than MAX_DOWNLOAD_MB.
AUTO_DOWNLOAD=false
MODEL_DOWNLOAD_URL=

# Maximum allowed download size in MiB (the bot will abort downloads larger than this)
MAX_DOWNLOAD_MB=290

# Where the downloaded model will be saved (do not change unless you know what you're doing)
LLAMA_MODEL_PATH=./models/auto_model.bin
# If you have a compiled llama.cpp binary on the host, set its path here. Leave empty if not available.
LLAMA_CPP_BIN=

# If transformers local loading is used as a fallback, this selects a HF model name (used when USE_HF_INFERENCE=false)
# For fast tests use: distilgpt2 ; For better quality via HF inference set MODEL_NAME to a HF model (e.g., bigscience/bloomz-560m)
MODEL_NAME=distilgpt2

# Behavior
REPLY_ALL=true
PORT=8080
CREATOR_REPLY=فهد المطيري @w4px

# Notes:
# - To avoid huge downloads on free hosts, prefer USE_HF_INFERENCE=true and provide HUGGINGFACE_HUB_TOKEN.
# - If you set AUTO_DOWNLOAD=true, ensure MODEL_DOWNLOAD_URL is a direct file link (HTTP 200) and its size <= MAX_DOWNLOAD_MB.
# - The bot uses a safe download flow: preflight Content-Length check, download to a .part file, and atomic rename on success.
# - If a file is partially downloaded or too small it will be removed automatically at startup to avoid "garbled" replies.
# - Running large models locally may require more CPU/RAM/disk than free hosting offers. Use HF inference for reliability.
